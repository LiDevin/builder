---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import OptionalTagLine from '../../components/OptionalTagLine.astro';

export async function getStaticPaths() {
  const entries = await getCollection('experience');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { company, title, dateRange, location, keyProducts, keyAccounts, overview, stack, caseStudies } =
  entry.data;
---

<Layout title={`${title} — ${company}`} description={overview}>
  <a class="back-link" href="/">&larr; Back</a>

  <h1>{title}</h1>
  <p class="role-meta">{company} &middot; {dateRange} &middot; {location}</p>
  <OptionalTagLine label="Key products" items={keyProducts} />
  <OptionalTagLine label="Key accounts" items={keyAccounts} />

  <p>{overview}</p>

  <h2>Tools &amp; Stack</h2>
  <ul class="stack-list">
    {stack.map((item) => <li>{item}</li>)}
  </ul>

  <h2>Case Studies</h2>
  <div class="case-study-list">
    {caseStudies.map((caseStudy) => (
      <article class="case-study">
        <h3>{caseStudy.title}</h3>
        <p><strong>Problem:</strong> {caseStudy.problem}</p>
        <p><strong>Approach:</strong> {caseStudy.approach}</p>
        <p><strong>Outcome:</strong> {caseStudy.outcome}</p>
        {caseStudy.details && (
          <details>
            <summary>Read more</summary>
            <ul class="details-list">
              {caseStudy.details.map((point) => <li>{point}</li>)}
            </ul>
          </details>
        )}
      </article>
    ))}
  </div>
</Layout>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: var(--space-3);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .role-meta {
    color: var(--color-text-muted);
    font-weight: var(--font-weight-muted);
    margin-top: 0;
  }

  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  .stack-list li {
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    padding: 0.125rem 0.625rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    font-size: 0.875rem;
  }

  .case-study-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .case-study {
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    padding: var(--space-3);
    transition: box-shadow var(--transition-fast);
  }

  /* Subtle lift on hover for tactile feedback — no color/cursor change,
     since this card isn't a link. */
  .case-study:hover {
    box-shadow: var(--shadow-sm-hover);
  }

  .case-study h3 {
    margin-block-start: 0;
    margin-block-end: var(--space-1);
  }

  .case-study p {
    margin-block: 0.375rem;
  }

  details {
    margin-top: var(--space-1);
  }

  details summary {
    cursor: pointer;
    color: var(--color-accent);
    font-size: 0.875rem;
    transition: color var(--transition-fast);
  }

  details summary:hover {
    color: var(--color-accent-hover);
  }

  .details-list {
    margin: var(--space-1) 0 0;
    padding-left: 1.125rem;
  }

  .details-list li {
    margin-block: 0.375rem;
    color: var(--color-text-muted);
    font-weight: var(--font-weight-muted);
  }

  .details-list li::marker {
    color: var(--color-accent);
  }
</style>
