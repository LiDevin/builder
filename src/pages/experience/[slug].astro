---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import OptionalTagLine from '../../components/OptionalTagLine.astro';

export async function getStaticPaths() {
  const entries = await getCollection('experience');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { company, title, dateRange, location, keyProducts, keyAccounts, overview, stack, caseStudies } =
  entry.data;
---

<Layout title={`${title} — ${company}`} description={overview}>
  <a class="back-link" href="/">&larr; Back</a>

  <h1>{title}</h1>
  <p class="role-meta">{company} &middot; {dateRange} &middot; {location}</p>
  <OptionalTagLine label="Key products" items={keyProducts} />
  <OptionalTagLine label="Key accounts" items={keyAccounts} />

  <p>{overview}</p>

  <h2>Tools &amp; Stack</h2>
  <ul class="stack-list">
    {stack.map((item) => <li>{item}</li>)}
  </ul>

  <h2>Case Studies</h2>
  <div class="case-study-list">
    {caseStudies.map((caseStudy) => (
      <details class="case-study">
        <summary class="case-study__summary">
          <div class="case-study__summary-text">
            <h3>{caseStudy.title}</h3>
            <p class="case-study__teaser">{caseStudy.teaser}</p>
          </div>
          <span class="case-study__chevron" aria-hidden="true"></span>
        </summary>
        <div class="case-study__body">
          <div class="stage stage--problem">
            <div class="stage__bar"></div>
            <div class="stage__body">
              <span class="stage__label">Problem</span>
              <p class="stage__text">{caseStudy.problem}</p>
            </div>
          </div>
          <div class="stage stage--approach">
            <div class="stage__bar"></div>
            <div class="stage__body">
              <span class="stage__label">Approach</span>
              <p class="stage__text">{caseStudy.approach}</p>
            </div>
          </div>
          <div class="stage stage--outcome">
            <div class="stage__bar"></div>
            <div class="stage__body">
              <span class="stage__label">Outcome</span>
              <p class="stage__text">{caseStudy.outcome}</p>
            </div>
          </div>
          {caseStudy.details && (
            <details class="read-more">
              <summary>Read more</summary>
              <ul class="details-list">
                {caseStudy.details.map((point) => <li>{point}</li>)}
              </ul>
            </details>
          )}
        </div>
      </details>
    ))}
  </div>
</Layout>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: var(--space-3);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .role-meta {
    color: var(--color-text-muted);
    font-weight: var(--font-weight-muted);
    margin-top: 0;
  }

  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  .stack-list li {
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    padding: 0.125rem 0.625rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    font-size: 0.875rem;
  }

  .case-study-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .case-study {
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition-fast);
  }

  /* Subtle lift on hover for tactile feedback — no color/cursor change,
     since the card itself isn't a link (the summary row is what's
     interactive). */
  .case-study:hover {
    box-shadow: var(--shadow-sm-hover);
  }

  .case-study__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-3);
    cursor: pointer;
    list-style: none;
  }

  .case-study__summary::-webkit-details-marker {
    display: none;
  }

  .case-study__summary-text h3 {
    margin-block-start: 0;
    margin-block-end: 0.25rem;
  }

  .case-study__teaser {
    margin: 0;
    color: var(--color-text-muted);
    font-weight: var(--font-weight-muted);
    font-size: 0.9375rem;
  }

  .case-study__chevron {
    flex: none;
    width: 0.625rem;
    height: 0.625rem;
    border-right: 2px solid var(--color-text-muted);
    border-bottom: 2px solid var(--color-text-muted);
    transform: rotate(-45deg);
    transition: transform var(--transition-fast);
  }

  .case-study[open] .case-study__chevron {
    transform: rotate(45deg);
  }

  .case-study__body {
    padding: 0 var(--space-3) var(--space-3);
  }

  .stage {
    display: flex;
    gap: var(--space-2);
    padding-block: 0.625rem;
  }

  .stage + .stage {
    border-top: 1px solid var(--color-border);
  }

  .stage__bar {
    flex: none;
    width: 3px;
    border-radius: 999px;
  }

  .stage--problem .stage__bar {
    background: var(--color-accent-faint);
  }

  .stage--approach .stage__bar {
    background: var(--color-accent-mid);
  }

  .stage--outcome .stage__bar {
    background: var(--color-accent);
  }

  .stage__body {
    flex: 1;
  }

  .stage__label {
    display: block;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }

  .stage__text {
    margin: 0;
  }

  .read-more {
    margin-top: var(--space-1);
  }

  .read-more summary {
    cursor: pointer;
    color: var(--color-accent);
    font-size: 0.875rem;
    transition: color var(--transition-fast);
  }

  .read-more summary:hover {
    color: var(--color-accent-hover);
  }

  .details-list {
    margin: var(--space-1) 0 0;
    padding-left: 1.125rem;
  }

  .details-list li {
    margin-block: 0.375rem;
    color: var(--color-text-muted);
    font-weight: var(--font-weight-muted);
  }

  .details-list li::marker {
    color: var(--color-accent);
  }
</style>
