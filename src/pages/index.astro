---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// Explicit reverse-chronological order — two entries don't need a generic
// date-sorting mechanism, the order is just authored here.
const roleEntries = await Promise.all([
  getEntry('experience', 'rogers-sports-media'),
  getEntry('experience', 'dentsu-international'),
]);

const roles = roleEntries.map((entry) => {
  if (!entry) {
    throw new Error('Home page references a missing experience entry');
  }
  return entry;
});

const email = 'devinlky@gmail.com';
const linkedInUrl = 'https://www.linkedin.com/in/devin-l-aaa08117a/';
---

<Layout
  title="Devin Li"
  description="Programmatic ad tech specialist across the full ecosystem — buy-side DSP execution, publisher-side ad operations, and exchange-level integrations."
>
  <h1>Devin Li</h1>
  <p class="tagline">
    Programmatic ad tech specialist across the full ecosystem — buy-side DSP execution,
    publisher-side ad operations, and exchange-level integrations.
  </p>
  <p>
    Currently at Rogers Sports &amp; Media managing programmatic infrastructure across all of
    Rogers' digital properties, with Sportsnet, CityNews, and SeekYourSounds.com requiring the
    most ongoing maintenance. Previously at dentsu international running multi-market campaigns
    across APAC and North America for global brands.
  </p>
  <h2>Skills</h2>
  <p class="skills-line">
    Google Ad Manager &middot; Magnite &middot; DV360 &middot; OpenRTB &middot; VAST/VMAP &middot;
    BigQuery &middot; SSP/DSP Integrations &middot; Workflow Automation &middot; Rich Media
  </p>
  <p>
    Hands-on with the code behind ad delivery: writes and amends JavaScript to build ad creative
    templates — DOM manipulation, conditional logic per placement — for sponsorship and rich media
    units; built a Python scraper covering 200+ digital properties to automate reporting; builds
    BigQuery-driven dashboards for real-time campaign insight. Self-taught, on the job.
  </p>

  <h2>Experience</h2>
  <ul class="role-list">
    {roles.map((role) => (
      <li>
        <a class="role-card" href={`/experience/${role.id}`}>
          <span class="role-card__title">{role.data.title} — {role.data.company}</span>
          <span class="role-card__meta">{role.data.dateRange}</span>
        </a>
      </li>
    ))}
  </ul>

  <h2>Contact</h2>
  <ul class="contact-list">
    <li><a href={`mailto:${email}`}>{email}</a></li>
    <li><a href={linkedInUrl}>LinkedIn</a></li>
  </ul>
</Layout>

<style>
  .tagline {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    font-weight: var(--font-weight-muted);
  }

  .skills-line {
    color: var(--color-text-muted);
    font-weight: var(--font-weight-muted);
    font-size: 0.9375rem;
  }

  .role-list,
  .contact-list {
    list-style: none;
    padding: 0;
  }

  .role-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .role-card {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1);
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    padding: var(--space-2);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: var(--color-text);
    transition: box-shadow var(--transition-fast), border-color var(--transition-fast);
  }

  .role-card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-sm-hover);
    color: var(--color-text);
  }

  .role-card__title {
    font-weight: 600;
  }

  .role-card__meta {
    color: var(--color-text-muted);
    font-weight: var(--font-weight-muted);
    font-size: 0.875rem;
  }

  .contact-list li {
    margin-block: 0.25rem;
  }
</style>
